{
  "name": "worktandem-frontend",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev:main": "pnpm --filter @worktandem/main dev",
    "dev:company": "pnpm --filter @worktandem/company dev",
    "dev:platform": "pnpm --filter @worktandem/platform dev",
    "prepare": "pnpm --filter \"./apps/*\" prepare",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs apps/platform/tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.1",
    "typescript": "~6.0.0"
  }
}
